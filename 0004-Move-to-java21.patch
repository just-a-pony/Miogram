From: Just_A_Pony <pony@just-a-pony.net>
Date: Wed, 15 Apr 2026 14:03:02 +0800
Subject: [PATCH 04/10] Move to java21

---
 TMessagesProj/build.gradle               | 5 ++---
 TMessagesProj_App/build.gradle           | 4 ++--
 TMessagesProj_AppStandalone/build.gradle | 4 ++--
 TMessagesProj_AppTests/build.gradle      | 6 +++---
 4 files changed, 9 insertions(+), 10 deletions(-)

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 15e025a39..20cff0a57 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -92,8 +92,8 @@ android {
     }
 
     compileOptions {
-        sourceCompatibility JavaVersion.VERSION_1_8
-        targetCompatibility JavaVersion.VERSION_1_8
+        sourceCompatibility JavaVersion.VERSION_21
+        targetCompatibility JavaVersion.VERSION_21
 
         coreLibraryDesugaringEnabled true
     }
@@ -229,7 +229,6 @@ def getProps(String propName) {
         return "";
     }
 }
-apply plugin: 'com.google.gms.google-services'
 
 task checkVisibility {
     doFirst {
diff --git a/TMessagesProj_App/build.gradle b/TMessagesProj_App/build.gradle
index 68e09135c..7b98c6745 100644
--- a/TMessagesProj_App/build.gradle
+++ b/TMessagesProj_App/build.gradle
@@ -35,8 +35,8 @@ android {
     }
 
     compileOptions {
-        sourceCompatibility JavaVersion.VERSION_1_8
-        targetCompatibility JavaVersion.VERSION_1_8
+        sourceCompatibility JavaVersion.VERSION_21
+        targetCompatibility JavaVersion.VERSION_21
 
         coreLibraryDesugaringEnabled true
     }
diff --git a/TMessagesProj_AppStandalone/build.gradle b/TMessagesProj_AppStandalone/build.gradle
index b06efd6ac..9f7d1648b 100644
